---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Interests from "../components/Interests.astro";
import Footer from "../components/Footer.astro";
import PixelTexture from "../components/PixelTexture.astro";
import { profile, aboutSections } from "../data/profile";
---

<Base title={`About · ${profile.name}`} description={profile.tagline}>
  <Header />
  <main class="textured">
    <PixelTexture />
    <About />
    {
      aboutSections.map((s) => (
        <section class="container section reveal">
          <h2 class="section-title">{s.title}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
        </section>
      ))
    }
    <Interests />
  </main>
  <Footer />
</Base>
