---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Interests from "../components/Interests.astro";
import Footer from "../components/Footer.astro";
import PixelTexture from "../components/PixelTexture.astro";
import { profile, aboutSections } from "../data/profile";
import { getLang, ui } from "../i18n";

const lang = getLang(Astro.url);
---

<Base title={`${ui[lang].about} · ${profile.name}`} description={profile.tagline[lang]}>
  <Header />
  <main class="textured">
    <PixelTexture />
    <About />
    {
      aboutSections.map((s) => (
        <section class="container section reveal">
          <h2 class="section-title">{s.title[lang]}</h2>
          {s.paragraphs[lang].map((p) => <p>{p}</p>)}
        </section>
      ))
    }
    <Interests />
  </main>
  <Footer />
</Base>
