---
import { experience } from "../data/profile";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section class="container section reveal" id="experience">
  <h2 class="section-title">Experience</h2>
  <ol class="timeline">
    {
      experience.map((job) => {
        const Frame = job.href ? "a" : "div";
        return (
        <li class:list={{ "has-logo": job.logo }}>
          {job.logo && (
            <Frame class="frame" href={job.href} target={job.href && "_blank"} rel={job.href && "noopener"} aria-label={job.href && job.company}>
              <img class="logo" src={`${base}${job.logo}`} alt="" />
            </Frame>
          )}
          <div>
            <div class="head">
              <h3>{job.href ? <a href={job.href} target="_blank" rel="noopener">{job.company}</a> : job.company}</h3>
              <span class="mono">{job.period}</span>
            </div>
            <p class="role">{job.role}</p>
            <p class="description">{job.description}</p>
          </div>
        </li>
        );
      })
    }
  </ol>
</section>

<style>
  .timeline {
    margin: 0;
    padding: 0 0 0 20px;
    list-style: none;
    border-left: 2px dotted var(--border);
  }

  li {
    position: relative;
  }

  li + li {
    margin-top: 28px;
  }

  /* Square marker sitting on the dotted line */
  li::before {
    content: "";
    position: absolute;
    top: 8px;
    left: -26px;
    width: 10px;
    height: 10px;
    background: var(--accent);
  }

  /* Logo tile on the left, details on the right; stacked on phones. */
  .has-logo {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 520px) {
    .has-logo {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* Framed like a cell on the contribution grid: dot texture, corner pixels. */
  .frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 168px;
    height: 96px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    background: radial-gradient(var(--border) 1px, transparent 1.5px) 0 0 / 13px 13px, var(--surface);
    transition: border-color 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
  }
  .frame::before,
  .frame::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .frame::before {
    top: 6px;
    left: 6px;
  }
  .frame::after {
    right: 6px;
    bottom: 6px;
  }
  li:hover .frame {
    border-color: var(--accent);
    box-shadow: var(--shadow-lift);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 12px;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* Logos are dark on transparent; flip them to light in dark mode. */
  .logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  :global(:root[data-theme="dark"]) .logo {
    filter: invert(1);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo {
      filter: invert(1);
    }
  }

  .role {
    margin: 0 0 6px;
    color: var(--muted);
  }

  .description {
    margin: 0;
  }
</style>
