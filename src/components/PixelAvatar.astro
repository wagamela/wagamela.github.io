---
// A symmetric 8×8 pixel pattern made from your name, like a GitHub identicon.
// Swap it for your own pixel art later if you want: put an image in /public
// and replace this component in Hero.astro.
interface Props {
  seed: string;
}

const { seed } = Astro.props;
const SIZE = 8;

// Small string hash → pseudo-random generator, so the pattern never changes.
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
const random = () => {
  h = Math.imul(h ^ (h >>> 15), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  return ((h ^= h >>> 16) >>> 0) / 4294967296;
};

const cells: { x: number; y: number; strong: boolean }[] = [];
for (let y = 0; y < SIZE; y++) {
  for (let x = 0; x < SIZE / 2; x++) {
    const r = random();
    if (r < 0.5) continue;
    const strong = r > 0.8;
    cells.push({ x, y, strong }, { x: SIZE - 1 - x, y, strong });
  }
}
---

<svg
  class="avatar"
  viewBox={`0 0 ${SIZE} ${SIZE}`}
  width="72"
  height="72"
  shape-rendering="crispEdges"
  role="img"
  aria-label="Pixel avatar"
>
  <rect width={SIZE} height={SIZE} class="bg" />
  {
    cells.map((c) => (
      <rect
        x={c.x}
        y={c.y}
        width="1"
        height="1"
        class:list={["px", { strong: c.strong }]}
        style={`--d:${(c.y * SIZE + c.x) * 18}ms`}
      />
    ))
  }
</svg>

<style>
  .avatar {
    display: block;
    flex-shrink: 0;
  }
  .bg {
    fill: var(--surface);
  }
  .px {
    fill: var(--g2);
    animation: pop 0.35s steps(3, end) var(--d) both;
  }
  .px.strong {
    fill: var(--g4);
  }
  @keyframes pop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
