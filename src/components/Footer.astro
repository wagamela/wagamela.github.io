---
import { profile } from "../data/profile";

const built = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" }).format(new Date());
---

<footer class="container footer mono">
  <span>© {new Date().getFullYear()} {profile.name}</span>
  <span>Hand-built with <a href="https://astro.build">Astro</a> · rebuilt daily, last on {built}</span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 24px;
    padding-bottom: 48px;
    border-top: 1px dashed var(--border);
  }
</style>
