---
import { profile } from "../data/profile";
import { getLang, ui } from "../i18n";

const lang = getLang(Astro.url);
const [before, after] = ui[lang].builtWith;

const built = new Intl.DateTimeFormat(lang, { month: "short", day: "numeric", year: "numeric" }).format(new Date());
---

<footer class="container footer mono">
  <span>© {new Date().getFullYear()} {profile.name}</span>
  <span>{before}<a href="https://astro.build">Astro</a>{after}{built}</span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 24px;
    padding-bottom: 48px;
    border-top: 1px dashed var(--border);
  }
</style>
