---
import { interests } from "../data/profile";
---

<section class="container section reveal" id="interests">
  <h2 class="section-title">When I'm not coding</h2>
  <ul class="chips">
    {interests.map((item, i) => <li style={`--l:var(--g${(i % 3) + 2})`}>{item}</li>)}
  </ul>
</section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each chip carries a square in a different graph shade. */
  li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 0.9375rem;
    transition: border-color 0.3s var(--ease-soft);
  }

  li::before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--l);
    transition: transform 0.2s steps(2, end);
  }

  li:hover {
    border-color: var(--accent);
  }
  li:hover::before {
    transform: rotate(90deg) scale(1.25);
  }
</style>
