// One rect per horizontal run of filled pixels.
const rows = icons[Astro.props.name];
const d = rows
  ?.flatMap((row, y) => [...row.matchAll(/#+/g)].map((m) => `M${m.index} ${y}h${m[0].length}v1H${m.index}z`))
  .join("");
---

{
  d && (
    <svg class="social-icon" viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
      <path fill="currentColor" d={d} />
    </svg>
  )
}

<style>
  .social-icon {
    flex-shrink: 0;
  }
</style>
