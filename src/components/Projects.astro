---
import { projects, type Project } from "../data/profile";
import PixelArrow from "./PixelArrow.astro";

const groups: { title: string; items: Project[] }[] = [
  { title: "Now building", items: projects.filter((p) => p.status === "current") },
  { title: "Earlier", items: projects.filter((p) => p.status === "past") },
].filter((g) => g.items.length > 0);
---

<section class="container section reveal" id="projects">
  <h2 class="section-title">Things I've built</h2>
  {
    groups.map((group) => (
      <div class="group">
        <h3 class="mono group-title">{group.title}</h3>
        <ul class="list">
          {group.items.map((p) => (
            <li class="card">
              <div class="head">
                <h4>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h4>
                {p.href && <PixelArrow />}
              </div>
              <p>{p.description}</p>
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .group + .group {
    margin-top: 28px;
  }

  .group-title {
    margin: 0 0 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    padding: 16px;
    border: 1px solid var(--border);
    background: var(--bg);
    transition: border-color 0.15s, background-color 0.15s;
  }

  /* Corner pixels light up on hover, like the card got selected. */
  .card::before,
  .card::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: scale(0);
    transition: transform 0.2s steps(3, end);
  }
  .card::before {
    top: -1px;
    left: -1px;
  }
  .card::after {
    right: -1px;
    bottom: -1px;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    background: var(--surface);
  }
  .card:hover::before,
  .card:hover::after,
  .card:focus-within::before,
  .card:focus-within::after {
    transform: scale(1);
  }
  .card:hover :global(.pixel-arrow),
  .card:focus-within :global(.pixel-arrow) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--muted);
  }

  h4 {
    margin: 0 0 6px;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
  }

  /* Make the whole card clickable when it has a link. */
  h4 a {
    text-decoration: none;
  }
  h4 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
