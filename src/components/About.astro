---
import { profile, socials } from "../data/profile";
import PixelArrow from "./PixelArrow.astro";
import SocialIcon from "./SocialIcon.astro";
---

<section class="container section reveal" id="about">
  <h2 class="section-title">The short version</h2>
  {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  <ul class="links">
    {
      socials.map((s) => (
        <li>
          <a href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
            {s.icon && <SocialIcon name={s.icon} />}
            {s.label}
            <PixelArrow />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  /* A green fill sweeps in from the left on hover, like a cell filling up.
     Scaling a pseudo-element stays on the compositor, so it never repaints. */
  .links a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .links a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--g1);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .links a:hover,
  .links a:focus-visible {
    border-color: var(--accent);
  }

  .links a:hover::before,
  .links a:focus-visible::before {
    transform: scaleX(1);
  }

  .links a :global(.pixel-arrow) {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .links a:hover :global(.pixel-arrow),
  .links a:focus-visible :global(.pixel-arrow) {
    transform: translate(2px, -2px);
  }
</style>
